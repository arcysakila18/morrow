# ── Public (exposed to the browser) ─────────────────────────────
# WalletConnect Cloud project id — enables WalletConnect / Robinhood Wallet (mobile) pairing.
NEXT_PUBLIC_WC_PROJECT_ID=
# Optional: private RPC for reads (e.g. Alchemy). Falls back to the public RPC, which is rate-limited.
NEXT_PUBLIC_RH_RPC_URL=

# ── Server-only (never prefix with NEXT_PUBLIC_) ────────────────
# 0x Swap API v2 key — adds 0x routing (incl. RFQ liquidity for Stock Tokens).
ZEROEX_API_KEY=
# 1inch Business API key — adds 1inch routing.
ONEINCH_API_KEY=
# DexPaprika API key (optional; raises market-data quota).
DEXPAPRIKA_API_KEY=
# Rialto partner API — reserved. Rialto's swap API is partner-gated and its schema is not public.
RIALTO_API_URL=
RIALTO_API_KEY=
# Server-side RPC used for token metadata reads.
RH_RPC_URL=
# Optional WebSocket RPC (e.g. wss://robinhood-mainnet.g.alchemy.com/v2/KEY) for realtime block updates.
NEXT_PUBLIC_RH_WS_URL=
