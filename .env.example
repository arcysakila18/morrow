# ── Public (exposed to the browser) ─────────────────────────────
# Privy app id (public). Wallet login, WalletConnect and embedded wallets are configured in the Privy dashboard.
NEXT_PUBLIC_PRIVY_APP_ID=cmwmfm0ic00la0hjhtqmtgv47
# Optional: private RPC for reads (e.g. Alchemy). Falls back to the public RPC, which is rate-limited.
NEXT_PUBLIC_RH_RPC_URL=

# ── Server-only (never prefix with NEXT_PUBLIC_) ────────────────
# 0x Swap API v2 key — adds 0x routing (incl. RFQ liquidity for Stock Tokens).
ZEROEX_API_KEY=
# 1inch Business API key — adds 1inch routing.
ONEINCH_API_KEY=
# DexPaprika API key (optional; raises market-data quota).
DEXPAPRIKA_API_KEY=
# Rialto partner API — reserved. Rialto's swap API is partner-gated and its schema is not public.
RIALTO_API_URL=
RIALTO_API_KEY=
# Server-side RPC used for token metadata reads.
RH_RPC_URL=
# Optional WebSocket RPC (e.g. wss://robinhood-mainnet.g.alchemy.com/v2/KEY) for realtime block updates.
NEXT_PUBLIC_RH_WS_URL=
# Optional logo.dev publishable token: higher-quality company logos for Stock Tokens (server-side).
LOGO_DEV_TOKEN=
# Optional private RPCs for the other networks (HTTP and WebSocket). Public RPCs are used otherwise.
NEXT_PUBLIC_RPC_URL_1=
NEXT_PUBLIC_RPC_URL_8453=
NEXT_PUBLIC_RPC_URL_42161=
NEXT_PUBLIC_RPC_URL_56=
NEXT_PUBLIC_WS_URL_1=
NEXT_PUBLIC_WS_URL_8453=
NEXT_PUBLIC_WS_URL_42161=
NEXT_PUBLIC_WS_URL_56=
# Server-side RPC per chain (falls back to the public RPC): RPC_URL_1, RPC_URL_8453, RPC_URL_42161, RPC_URL_56
# Optional CoinGecko demo/pro key for token logos (server-side).
COINGECKO_API_KEY=
# Solana: RPC for wallet balances (public mainnet-beta is heavily rate-limited; Helius/Alchemy recommended).
SOLANA_RPC_URL=
# Solana RPC used by the browser to send bridge transactions (optional, falls back to public).
NEXT_PUBLIC_SOLANA_RPC_URL=
# Optional Jupiter API key (higher limits). Without it the free lite-api is used.
JUPITER_API_KEY=
# Optional LI.FI API key for bridging (higher limits).
LIFI_API_KEY=
